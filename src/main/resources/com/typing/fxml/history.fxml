<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="historyScreenRoot" styleClass="screen-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typing.controller.HistoryController">
    <children>
        <VBox spacing="20.0">
            <children>
                <!-- Top Summary Strip Card -->
                <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="panel-card" style="-fx-padding: 16px 24px;">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label fx:id="totalTestsLabel" styleClass="panel-card-title" text="8 Total Tests" />
                                <Label styleClass="panel-card-subtitle" text="All recorded typing sessions" />
                            </children>
                        </VBox>

                        <Separator orientation="VERTICAL" styleClass="separator" style="-fx-opacity: 0.25;" />

                        <VBox spacing="2.0">
                            <children>
                                <Label fx:id="highestWpmLabel" styleClass="panel-card-title, text-accent" text="Peak: 91 WPM" />
                                <Label styleClass="panel-card-subtitle" text="Fastest benchmark achieved" />
                            </children>
                        </VBox>

                        <Separator orientation="VERTICAL" styleClass="separator" style="-fx-opacity: 0.25;" />

                        <VBox spacing="2.0">
                            <children>
                                <Label fx:id="avgAccuracyLabel" styleClass="panel-card-title, text-accent" text="Average Accuracy: 98.4%" />
                                <Label styleClass="panel-card-subtitle" text="Aggregate precision rate" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnStartNewTest" styleClass="btn-primary" text="+ New Typing Test" />
                    </children>
                </HBox>

                <!-- Filter & Search Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="panel-card" style="-fx-padding: 14px 20px;">
                    <children>
                        <TextField fx:id="searchField" prefWidth="280.0" promptText="Search by mode, grade, date..." />

                        <ComboBox fx:id="filterCombo" prefWidth="170.0" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnClearHistory" styleClass="btn-danger" text="Clear History" />
                    </children>
                </HBox>

                <!-- History Table & Empty State Container -->
                <StackPane VBox.vgrow="ALWAYS">
                    <children>
                        <!-- TableView -->
                        <TableView fx:id="historyTable" prefHeight="400.0">
                            <columns>
                                <TableColumn fx:id="colDate" prefWidth="170.0" text="DATE &amp; TIME" />
                                <TableColumn fx:id="colMode" prefWidth="120.0" text="MODE" />
                                <TableColumn fx:id="colDuration" prefWidth="100.0" text="DURATION" />
                                <TableColumn fx:id="colWpm" prefWidth="110.0" text="SPEED (WPM)" />
                                <TableColumn fx:id="colAccuracy" prefWidth="100.0" text="ACCURACY" />
                                <TableColumn fx:id="colErrors" prefWidth="90.0" text="ERRORS" />
                                <TableColumn fx:id="colScore" prefWidth="100.0" text="SCORE" />
                                <TableColumn fx:id="colGrade" prefWidth="90.0" text="GRADE" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Empty State View -->
                        <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="12.0" visible="false" managed="false" styleClass="panel-card" style="-fx-padding: 40px;">
                            <children>
                                <Label styleClass="dialog-title" text="No Test Records Found" />
                                <Label styleClass="dialog-message" text="You have not completed any typing tests matching the current criteria yet." />
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </VBox>
    </children>
</StackPane>
