<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="testScreenRoot" styleClass="screen-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typing.controller.TypingTestController">
    <children>
        <VBox spacing="20.0">
            <children>
                <!-- Top Test Config Header Bar -->
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="panel-card" style="-fx-padding: 14px 20px;">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="panel-card-title" text="Typing Speed Benchmark" />
                                <Label styleClass="panel-card-subtitle" text="Type the target text accurately below. Timer begins on first keystroke." />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Active Mode Indicators & Dropdown Adjusters -->
                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <HBox alignment="CENTER" spacing="6.0">
                                    <children>
                                        <Label styleClass="section-caption" text="DIFFICULTY:" />
                                        <ComboBox fx:id="difficultyCombo" prefWidth="120.0" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER" spacing="6.0">
                                    <children>
                                        <Label styleClass="section-caption" text="DURATION:" />
                                        <ComboBox fx:id="durationCombo" prefWidth="120.0" />
                                    </children>
                                </HBox>

                                <Label fx:id="modeBadgeLabel" styleClass="badge-medium" text="Medium Mode" />
                                <Label fx:id="durationBadgeLabel" styleClass="badge-easy" text="60s" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Real-time HUD Metrics Strip -->
                <HBox fx:id="statsHudContainer" spacing="18.0" maxWidth="Infinity">
                    <children>
                        <!-- Countdown Timer Card -->
                        <VBox alignment="CENTER" styleClass="hud-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="5.0">
                            <children>
                                <Label styleClass="hud-title" text="TIME REMAINING" />
                                <Label fx:id="timerLabel" styleClass="hud-value-large" text="01:00" />
                                <ProgressBar fx:id="timerProgressBar" progress="1.0" maxWidth="Infinity" />
                            </children>
                        </VBox>

                        <!-- Live WPM Card -->
                        <VBox alignment="CENTER" styleClass="hud-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="5.0">
                            <children>
                                <Label styleClass="hud-title" text="CURRENT SPEED" />
                                <HBox alignment="CENTER" spacing="4.0">
                                    <children>
                                        <Label fx:id="liveWpmLabel" styleClass="hud-value-large, text-accent" text="0" />
                                        <Label styleClass="text-muted" style="-fx-font-size: 12px; -fx-font-weight: 600;" text="WPM" />
                                    </children>
                                </HBox>
                                <Label styleClass="text-muted" style="-fx-font-size: 10px;" text="Net words / min" />
                            </children>
                        </VBox>

                        <!-- Live Accuracy Card -->
                        <VBox alignment="CENTER" styleClass="hud-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="5.0">
                            <children>
                                <Label styleClass="hud-title" text="ACCURACY" />
                                <Label fx:id="liveAccuracyLabel" styleClass="hud-value-large" text="100%" />
                                <Label styleClass="text-muted" style="-fx-font-size: 10px;" text="Correct characters ratio" />
                            </children>
                        </VBox>

                        <!-- Error Count Card -->
                        <VBox alignment="CENTER" styleClass="hud-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="5.0">
                            <children>
                                <Label styleClass="hud-title" text="ERRORS" />
                                <Label fx:id="liveErrorsLabel" styleClass="hud-value-large" text="0" />
                                <Label styleClass="text-muted" style="-fx-font-size: 10px;" text="Mistyped keystrokes" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Target Text Display Card (Main focus workspace) -->
                <VBox spacing="10.0" styleClass="panel-card">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="section-caption" text="TARGET PASSAGE" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="typingHintLabel" styleClass="text-secondary" style="-fx-font-size: 12px; -fx-font-weight: 400;" text="Click the text box and begin typing to start timer automatically." />
                            </children>
                        </HBox>

                        <StackPane alignment="TOP_LEFT" styleClass="target-text-card">
                            <children>
                                <Label fx:id="targetTextLabel" styleClass="target-text-display" text="Target passage text will appear here." />
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <!-- User Typing Input Area -->
                <VBox spacing="10.0" styleClass="panel-card" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-caption" text="TYPING INPUT" />

                        <TextArea fx:id="typingInputArea" promptText="Start typing the passage here..." styleClass="typing-input-area" VBox.vgrow="ALWAYS" />

                        <!-- Action Control Buttons -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 8px 0 0 0;">
                            <children>
                                <Button fx:id="btnRestart" styleClass="btn-secondary" text="Restart Test ↺" />
                                <Button fx:id="btnFinish" styleClass="btn-secondary" text="Finish &amp; Score ✓" />
                                <Button fx:id="btnStartPause" styleClass="btn-primary" text="Start Test ▶" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
