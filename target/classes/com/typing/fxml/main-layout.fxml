<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootStackPane" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typing.controller.MainLayoutController">
    <children>
        <BorderPane styleClass="main-background">
            <!-- Left Sidebar Navigation -->
            <left>
                <VBox fx:id="sidebarContainer" styleClass="sidebar-container" BorderPane.alignment="CENTER">
                    <children>
                        <!-- App Logo and Brand Title -->
                        <HBox fx:id="logoBox" alignment="CENTER_LEFT" styleClass="logo-box">
                            <children>
                                <VBox spacing="1.0">
                                    <children>
                                        <Label fx:id="appTitleLabel" styleClass="app-title" text="Typing Analyzer" />
                                        <Label styleClass="brand-subtitle" text="Performance Studio" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Dynamic Navigation Items Container -->
                        <VBox fx:id="navButtonsContainer" styleClass="nav-buttons-container" spacing="4.0" />

                        <!-- Flexible spacer pushing footer to bottom -->
                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Version and status footer -->
                        <Label fx:id="appVersionLabel" styleClass="app-version" text="Typing Studio • v1.0" />
                    </children>
                </VBox>
            </left>

            <!-- Main Content Area -->
            <center>
                <VBox BorderPane.alignment="CENTER" styleClass="main-content-vbox">
                    <children>
                        <!-- Top Header Bar -->
                        <HBox alignment="CENTER_LEFT" styleClass="header-bar">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label fx:id="pageTitleLabel" styleClass="page-title" text="Dashboard Overview" />
                                        <Label styleClass="page-subtitle" text="Track metrics, build muscle memory, and measure typing velocity." />
                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <!-- One-Click Theme Toggle Button -->
                                <Button fx:id="btnThemeToggle" styleClass="theme-toggle-btn" focusTraversable="false">
                                    <tooltip>
                                        <Tooltip text="Toggle Light / Dark Mode" />
                                    </tooltip>
                                </Button>

                                <Separator orientation="VERTICAL" styleClass="separator" style="-fx-opacity: 0.25; -fx-padding: 0 4px;" />

                                <!-- User Profile Card -->
                                <HBox alignment="CENTER" spacing="12.0">
                                    <children>
                                        <VBox alignment="CENTER_RIGHT" spacing="1.0">
                                            <children>
                                                <Label fx:id="userWelcomeLabel" styleClass="user-name-title" text="Alex Mercer" />
                                                <Label fx:id="userHandleLabel" styleClass="user-handle-subtitle" text="\@alex_typing" />
                                            </children>
                                        </VBox>
                                        <StackPane styleClass="user-avatar-badge">
                                            <children>
                                                <Label fx:id="userAvatarLabel" styleClass="user-avatar-text" text="AM" />
                                            </children>
                                        </StackPane>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Dynamic Screen Content Switcher with ScrollPane for graceful resizing -->
                        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-area-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <StackPane fx:id="contentPane" styleClass="content-pane" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</StackPane>
